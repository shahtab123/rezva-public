# =============================================================================
# Rezva — single env file for local development
# =============================================================================
# 1. Copy this file once:
#      copy .env.example .env.local
# 2. Fill the REQUIRED section below.
# 3. Run: npm run build && npm run db:migrate:neon && npm run dev
#
# npm run dev syncs this file into registry/.dev.vars for the API Worker.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — app will not run usefully without these
# -----------------------------------------------------------------------------

# Neon Postgres connection string (local + production). Required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Privy app (https://dashboard.privy.io) — dashboard /website login
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Website → API base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# -----------------------------------------------------------------------------
# Local API keys (safe defaults for demos — change for any shared/staging deploy)
# -----------------------------------------------------------------------------

# Wallet-provider style key used by local resolve / registry calls
DEV_PROVIDER_KEY=dev-provider-key

# Dashboard server → registry (identifier / name mutations)
DASHBOARD_PROVIDER_API_KEY=dev-provider-key

# Dashboard server → registry (Free API key mint / manage)
DASHBOARD_SERVICE_KEY=dev-provider-key

# Admin / operator actions
OPERATOR_API_KEY=dev-operator-key

# Local controller auth: "dev" accepts X-Controller-Wallet without HMAC.
# Production Workers must use CONTROLLER_AUTH_MODE=hmac + CONTROLLER_AUTH_HMAC_SECRET.
CONTROLLER_AUTH_MODE=dev
# CONTROLLER_AUTH_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Safety timers (0 = instant activate — OK for local demos only)
# -----------------------------------------------------------------------------

REGISTRATION_SAFETY_SECONDS=0
UPDATE_SAFETY_SECONDS=0
NEXT_PUBLIC_REGISTRATION_SAFETY_SECONDS=0
REMOVAL_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# Shared Test Merchant (Free API demo on Base Sepolia)
# -----------------------------------------------------------------------------
# One protocol-wide demo merchant. Do not replace with a personal wallet.

TEST_MERCHANT_WALLET=0xa1b1c36bcAA6e6f89f409124220f79A049843a17
TEST_MERCHANT_IDENTIFIER=rezva-test-merchant
TEST_MERCHANT_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# URL printed in QR payloads for wallets (must be publicly reachable).
# Local API can stay on 127.0.0.1; QR should still point at a public Worker in demos.
RESOLVER_URL=http://127.0.0.1:8787/v1/resolve
PUBLIC_RESOLVER_URL=https://universal-payment-api.sabrishahtab.workers.dev/v1/resolve

# -----------------------------------------------------------------------------
# Universal Name Resolution (optional — public RPCs work if unset)
# -----------------------------------------------------------------------------

# ETHEREUM_RPC_URL=https://1rpc.io/eth
# BASE_RPC_URL=https://mainnet.base.org
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional Unstoppable Partner Resolution REST key (on-chain UNS is preferred):
# UNSTOPPABLE_API_KEY=

# -----------------------------------------------------------------------------
# Admin console (/admin) — Auth.js
# -----------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-admin-auth-secret-change-me

# Local default login is admin / admin (seeded store).
# On Vercel set explicit credentials:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-password

# -----------------------------------------------------------------------------
# Optional infrastructure
# -----------------------------------------------------------------------------

# NEXT_PUBLIC_REOWN_PROJECT_ID=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Production Worker checklist (Cloudflare, not .env.local)
# -----------------------------------------------------------------------------
# ENVIRONMENT=production
# CONTROLLER_AUTH_MODE=hmac
# CONTROLLER_AUTH_HMAC_SECRET=<strong secret>
# OPERATOR_API_KEY / DASHBOARD_SERVICE_KEY / DASHBOARD_PROVIDER_API_KEY=<strong secrets>
# OPERATOR_RECLAIM_DUAL_TOKEN=<strong secret>
# REGISTRATION_SAFETY_SECONDS / UPDATE_SAFETY_SECONDS > 0
# NEXT_PUBLIC_API_URL=https://<your-worker>.workers.dev
