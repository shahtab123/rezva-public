# One env file for the whole repo. Copy once:
#   copy .env.example .env.local
#
# Used by: npm run dev (API worker + website)

# --- API worker ---

DEV_PROVIDER_KEY=dev-provider-key
# Server-side key the dashboard BFF uses for registry mutations (defaults to DEV_PROVIDER_KEY)
DASHBOARD_PROVIDER_API_KEY=dev-provider-key
# Dedicated server-to-registry key for dashboard Free API lifecycle routes.
DASHBOARD_SERVICE_KEY=dev-provider-key
OPERATOR_API_KEY=dev-operator-key
# Controller auth: "dev" = X-Controller-Wallet only (local). "hmac" = signed tickets + replay protection.
CONTROLLER_AUTH_MODE=dev
# CONTROLLER_AUTH_HMAC_SECRET=
# Production Cloudflare Worker must set:
#   ENVIRONMENT=production
#   CONTROLLER_AUTH_MODE=hmac
#   CONTROLLER_AUTH_HMAC_SECRET=<strong secret>
#   OPERATOR_API_KEY / DASHBOARD_SERVICE_KEY / DASHBOARD_PROVIDER_API_KEY=<strong secrets>
#   OPERATOR_RECLAIM_DUAL_TOKEN=<strong secret>
#   REGISTRATION_SAFETY_SECONDS / UPDATE_SAFETY_SECONDS > 0
# Local leave ENVIRONMENT unset so CONTROLLER_AUTH_MODE=dev keeps working.
REGISTRATION_SAFETY_SECONDS=0
UPDATE_SAFETY_SECONDS=0
# Mirrored to the dashboard UI (auto-synced to website/.env.local by npm run dev)
NEXT_PUBLIC_REGISTRATION_SAFETY_SECONDS=0
REMOVAL_COOLDOWN_SECONDS=300
# One persistent protocol demo merchant for every developer/user.
# Do not set this to a per-user wallet or generate it during a request.
TEST_MERCHANT_WALLET=0xa1b1c36bcAA6e6f89f409124220f79A049843a17
TEST_MERCHANT_IDENTIFIER=rezva-test-merchant
TEST_MERCHANT_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
RESOLVER_URL=http://127.0.0.1:8787/v1/resolve

# --- Universal Name Resolution (external naming systems) ---
# ETHEREUM_RPC_URL=https://1rpc.io/eth
# BASE_RPC_URL=https://mainnet.base.org
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SNS_RESOLVE_URL=https://example.com/resolve/{name}
# Optional Partner Resolution REST key (NOT the Account Settings ud_mcp_* MCP key):
# UNSTOPPABLE_API_KEY=

# --- Website (Privy login + dashboard) ---

NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Privy server auth - required for BFF JWT verification and getTestAccessToken() in smoke tests
PRIVY_APP_SECRET=
# Optional: origin for Privy test login (must be in Dashboard → Settings → Domains)
# PRIVY_TEST_ORIGIN=http://localhost:3000
# Optional: pick a specific test account email (OTP fetched automatically from Privy API)
# PRIVY_TEST_EMAIL=test-6621@privy.io

# --- Admin dashboard (Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-admin-auth-secret-change-me
# Local default seed: admin / admin (website/.data/admin-store.json)
# On Vercel set these so /admin login works without a writable filesystem:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-password

# --- Infrastructure (fill when you have accounts) ---

# DATABASE_URL=postgresql://...  # REQUIRED - Neon for local + production (no local D1)
# Real-payment E2E only; keep the sender key in the current terminal session.
# TEST19_SENDER_PRIVATE_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
